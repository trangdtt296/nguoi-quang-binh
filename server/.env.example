NODE_ENV=development
PORT=5000

# Chuỗi kết nối Postgres. Lấy từ bảng điều khiển Neon (neon.tech), nhớ giữ
# sslmode=require ở cuối.
DATABASE_URL=postgresql://user:password@host.neon.tech/nguoi_quang_binh?sslmode=require

# Chuỗi bí mật ký JWT — phải dài ít nhất 32 ký tự và KHÁC NHAU.
# Sinh nhanh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cloudinary — để trống thì API vẫn chạy, chỉ không tải ảnh lên được.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Các origin được phép gọi API, cách nhau bằng dấu phẩy.
CORS_ORIGIN=http://localhost:3000

# Địa chỉ website, dùng cho sitemap.xml và robots.txt.
SITE_URL=http://localhost:3000

# Tài khoản super admin đầu tiên, chỉ dùng khi chạy npm run db:seed.
# Mật khẩu phải dài ít nhất 10 ký tự. Đổi ngay sau lần đăng nhập đầu.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
