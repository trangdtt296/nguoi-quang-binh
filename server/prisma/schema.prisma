// Schema PostgreSQL — Người Quảng Bình
// Thiết kế đầy đủ xem docs/04-database.md.
//
// Quy ước chung:
// - Khóa chính là UUID, để không lộ số lượng bản ghi qua URL.
// - Mọi bảng nội dung đều có createdAt / updatedAt / deletedAt (xóa mềm).
// - Truy vấn công khai luôn lọc deletedAt = null và status = published.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  editor
  admin
  super_admin
}

enum ContentStatus {
  draft
  published
  scheduled
  archived
}

enum ArticleType {
  news
  culture
  guide
  lesson
}

enum CategoryType {
  article
  destination
  food
  event
  culture
  guide
  learning
}

enum MediaType {
  image
  video
  embed
}

enum BannerPosition {
  home_hero
  home_middle
  sidebar
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  fullName     String    @map("full_name")
  avatarUrl    String?   @map("avatar_url")
  role         UserRole  @default(editor)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  articles     Article[]
  uploadedMedia Media[]

  @@map("users")
}

model Category {
  id             String       @id @default(uuid())
  type           CategoryType
  name           String
  slug           String
  description    String?
  parentId       String?      @map("parent_id")
  coverImageUrl  String?      @map("cover_image_url")
  sortOrder      Int          @default(0) @map("sort_order")
  isActive       Boolean      @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  articles     Article[]
  destinations Destination[]
  foods        Food[]
  events       Event[]
  albums       Album[]
  courses      LearningCourse[]

  // Cho phép cùng một slug tồn tại ở hai loại danh mục khác nhau.
  @@unique([type, slug])
  @@index([type, isActive])
  @@map("categories")
}

model Article {
  id             String        @id @default(uuid())
  title          String
  slug           String        @unique
  excerpt        String?
  /// Nội dung TipTap dạng JSON, dùng khi sửa lại trong CMS.
  content        Json
  /// Bản HTML render sẵn, dùng khi trả về cho frontend và bot.
  contentHtml    String?       @map("content_html")
  coverImageUrl  String?       @map("cover_image_url")
  type           ArticleType
  categoryId     String?       @map("category_id")
  authorId       String        @map("author_id")
  tags           String[]      @default([])
  status         ContentStatus @default(draft)
  publishedAt    DateTime?     @map("published_at")
  viewCount      Int           @default(0) @map("view_count")
  isFeatured     Boolean       @default(false) @map("is_featured")

  // Dành riêng cho bài học trong Góc học tập (type = lesson)
  courseId        String? @map("course_id")
  lessonOrder     Int?    @map("lesson_order")
  videoUrl        String? @map("video_url")
  durationMinutes Int?    @map("duration_minutes")

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  ogImageUrl     String? @map("og_image_url")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category     Category?       @relation(fields: [categoryId], references: [id])
  author       User            @relation(fields: [authorId], references: [id])
  course       LearningCourse? @relation(fields: [courseId], references: [id])
  media        ArticleMedia[]
  destinations ArticleDestination[]

  @@unique([courseId, lessonOrder])
  @@index([type, status, publishedAt])
  @@index([categoryId])
  @@map("articles")
}

model Destination {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  summary       String?
  content       Json?
  contentHtml   String?       @map("content_html")
  coverImageUrl String?       @map("cover_image_url")
  categoryId    String?       @map("category_id")
  region        String?
  address       String?
  latitude      Decimal?      @db.Decimal(10, 7)
  longitude     Decimal?      @db.Decimal(10, 7)
  bestTime      String?       @map("best_time")
  /// Mảng { label, value } — giờ mở cửa, cách đi, lưu ý.
  visitInfo     Json?         @map("visit_info")
  status        ContentStatus @default(draft)
  publishedAt   DateTime?     @map("published_at")
  viewCount     Int           @default(0) @map("view_count")
  isFeatured    Boolean       @default(false) @map("is_featured")

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  ogImageUrl     String? @map("og_image_url")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category Category?            @relation(fields: [categoryId], references: [id])
  media    DestinationMedia[]
  articles ArticleDestination[]
  events   Event[]

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([region])
  @@map("destinations")
}

model Food {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  summary       String?
  content       Json?
  contentHtml   String?       @map("content_html")
  coverImageUrl String?       @map("cover_image_url")
  categoryId    String?       @map("category_id")
  season        String?
  originStory   String?       @map("origin_story")
  /// Mảng { name, address } — nơi thưởng thức.
  whereToEat    Json?         @map("where_to_eat")
  status        ContentStatus @default(draft)
  publishedAt   DateTime?     @map("published_at")
  viewCount     Int           @default(0) @map("view_count")
  isFeatured    Boolean       @default(false) @map("is_featured")

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  ogImageUrl     String? @map("og_image_url")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([status, publishedAt])
  @@map("foods")
}

model Event {
  id            String        @id @default(uuid())
  name          String
  slug          String        @unique
  summary       String?
  content       Json?
  contentHtml   String?       @map("content_html")
  coverImageUrl String?       @map("cover_image_url")
  categoryId    String?       @map("category_id")
  destinationId String?       @map("destination_id")
  locationText  String?       @map("location_text")
  startAt       DateTime      @map("start_at")
  endAt         DateTime?     @map("end_at")
  isRecurring   Boolean       @default(false) @map("is_recurring")
  status        ContentStatus @default(draft)
  publishedAt   DateTime?     @map("published_at")

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  ogImageUrl     String? @map("og_image_url")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category    Category?    @relation(fields: [categoryId], references: [id])
  destination Destination? @relation(fields: [destinationId], references: [id])

  @@index([status, startAt])
  @@map("events")
}

model LearningCourse {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  description   String?
  coverImageUrl String?       @map("cover_image_url")
  categoryId    String?       @map("category_id")
  /// Đếm sẵn số bài để trang danh sách không phải đếm mỗi lần tải.
  lessonCount   Int           @default(0) @map("lesson_count")
  status        ContentStatus @default(draft)
  publishedAt   DateTime?     @map("published_at")
  viewCount     Int           @default(0) @map("view_count")
  isFeatured    Boolean       @default(false) @map("is_featured")

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  ogImageUrl     String? @map("og_image_url")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category Category? @relation(fields: [categoryId], references: [id])
  lessons  Article[]

  @@index([status, publishedAt])
  @@map("learning_courses")
}

model Media {
  id           String    @id @default(uuid())
  /// ID trên Cloudinary, cần để xóa file khi xóa bản ghi.
  publicId     String?   @map("public_id")
  url          String
  thumbnailUrl String?   @map("thumbnail_url")
  type         MediaType @default(image)
  fileName     String?   @map("file_name")
  mimeType     String?   @map("mime_type")
  sizeBytes    BigInt?   @map("size_bytes")
  width        Int?
  height       Int?
  altText      String?   @map("alt_text")
  caption      String?
  folder       String?
  uploadedById String?   @map("uploaded_by")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  uploadedBy   User?              @relation(fields: [uploadedById], references: [id])
  albums       AlbumMedia[]
  articles     ArticleMedia[]
  destinations DestinationMedia[]

  @@index([type])
  @@map("media")
}

model Album {
  id            String        @id @default(uuid())
  title         String
  slug          String        @unique
  description   String?
  coverImageUrl String?       @map("cover_image_url")
  categoryId    String?       @map("category_id")
  status        ContentStatus @default(draft)
  publishedAt   DateTime?     @map("published_at")
  sortOrder     Int           @default(0) @map("sort_order")

  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description")
  ogImageUrl     String? @map("og_image_url")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  category Category?    @relation(fields: [categoryId], references: [id])
  items    AlbumMedia[]

  @@index([status, publishedAt])
  @@map("albums")
}

model AlbumMedia {
  albumId   String @map("album_id")
  mediaId   String @map("media_id")
  sortOrder Int    @default(0) @map("sort_order")

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([albumId, mediaId])
  @@map("album_media")
}

model ArticleMedia {
  articleId String @map("article_id")
  mediaId   String @map("media_id")
  sortOrder Int    @default(0) @map("sort_order")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([articleId, mediaId])
  @@map("article_media")
}

model DestinationMedia {
  destinationId String @map("destination_id")
  mediaId       String @map("media_id")
  sortOrder     Int    @default(0) @map("sort_order")

  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  media       Media       @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([destinationId, mediaId])
  @@map("destination_media")
}

/// Nối bài viết với điểm đến, phục vụ khối "bài viết liên quan".
model ArticleDestination {
  articleId     String @map("article_id")
  destinationId String @map("destination_id")

  article     Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  destination Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@id([articleId, destinationId])
  @@map("article_destinations")
}

model Banner {
  id              String         @id @default(uuid())
  title           String
  subtitle        String?
  imageUrl        String?        @map("image_url")
  mobileImageUrl  String?        @map("mobile_image_url")
  linkUrl         String?        @map("link_url")
  position        BannerPosition @default(home_hero)
  sortOrder       Int            @default(0) @map("sort_order")
  isActive        Boolean        @default(true) @map("is_active")
  startAt         DateTime?      @map("start_at")
  endAt           DateTime?      @map("end_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([position, isActive])
  @@map("banners")
}

/// Cấu hình website dạng key-value, để thêm mục mới không phải migrate.
model Setting {
  key       String   @id
  value     Json
  group     String   @default("general")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model ContactMessage {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name")
  email     String
  phone     String?
  subject   String?
  message   String
  ipAddress String?  @map("ip_address")
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isRead, createdAt])
  @@map("contact_messages")
}

/// Lượt xem gộp theo ngày — giữ bảng nhỏ mà vẫn vẽ được biểu đồ.
model PageView {
  id          BigInt   @id @default(autoincrement())
  contentType String   @map("content_type")
  contentId   String   @map("content_id")
  viewedDate  DateTime @map("viewed_date") @db.Date
  viewCount   Int      @default(0) @map("view_count")

  @@unique([contentType, contentId, viewedDate])
  @@index([viewedDate])
  @@map("page_views")
}
