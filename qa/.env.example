# Sao chép thành qa/.env rồi điền. File .env không được commit.

# Địa chỉ web và API đang chạy (local hoặc bản deploy thử nghiệm).
QA_WEB_URL=http://localhost:3000
QA_API_URL=http://localhost:5000/api/v1

# Tài khoản super_admin để chạy case quản trị (thường là tài khoản seed).
# KHÔNG dùng tài khoản thật trên production: case quản trị sẽ tạo và xóa dữ liệu.
QA_ADMIN_EMAIL=
QA_ADMIN_PASSWORD=

# Tài khoản vai trò editor cho case phân quyền. Bỏ trống thì các case đó là BLOCKED.
QA_EDITOR_EMAIL=
QA_EDITOR_PASSWORD=

# Đặt 1 để chạy cả case làm tốn hạn mức của server:
# đăng nhập sai (5 lần/15 phút sẽ khóa IP), gửi form liên hệ (5 tin/giờ).
QA_ALLOW_RATE_LIMITED=0
